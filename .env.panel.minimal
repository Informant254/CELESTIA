# ═════════════════════════════════
#     ✨ CELESTIA PANEL CONNECTION
#   Howl of the Wolf → Light of the Stars
# ═════════════════════════════════
# Minimal env for panels (nodeX / Pterodactyl / any host).
# Paste into the server's environment and start. That's the whole setup —
# the number that linked the session becomes the owner automatically.

# ── REQUIRED ─────────────────────
SESSION_ID=


# ── OPTIONAL: PostgreSQL Database ────────────
# Leave blank to run on SQLite only (default)
# Supports Heroku Postgres, Supabase, Neon, Railway, etc.
# Format: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=


# ── PANEL NETWORKING ─────────────
# Nothing to fill in here. Your panel assigns the port automatically
# and injects it as PORT — she listens on it with zero config.
# Give the container ONE allocation. Health check: GET /health
