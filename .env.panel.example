# ═════════════════════════════════
#           ✨ CELESTIA CONFIGURATION
#   Howl of the Wolf → Light of the Stars
# ═════════════════════════════════
# Copy to .env and fill. On nodeX/Pterodactyl panels,
# paste these into the server's environment instead.

# ── REQUIRED ─────────────────────
# Paste the full string (CELESTIA:~xxxx...). Get one from
# the pairing station or the backup the bot DMs its owner.
# Treat like a password — anyone holding it owns this link.
SESSION_ID=

# ── BOT IDENTITY ─────────────────
# OWNER_NUMBER is OPTIONAL: leave blank and she discovers
# the owner automatically — the number that linked IS the owner.
# (Set it only to force a different owner.)
OWNER_NUMBER=
BOT_NAME=CELESTIA
BOT_PREFIX=.
TIMEZONE=Africa/Nairobi

# ── BEHAVIOR TOGGLES ─────────────
# true/false. Typing/recording presence, raw message logs, log verbosity.
AUTO_TYPING=false
AUTO_RECORDING=false
DEBUG_MESSAGES=false
LOG_LEVEL=info
# Cloud pairing loop: 'true' prints pairing codes in logs instead of booting.
# Link it, flip back to 'false', redeploy.
PAIR_MODE=false

# ── OPTIONAL: PostgreSQL Database ────────────
# Leave blank to run on SQLite only (default).
# Supports Heroku Postgres, Supabase, Neon, Railway, etc.
# Format: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ── OPTIONAL: AI Features ────────────────────
# Powers .ai .gpt .gemini .roast .imagine and friends.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── OPTIONAL: Media APIs ─────────────────────
# imgbb: .url uploads | OCR.Space: .ocr | Google STT: voice transcribe
# ACRCloud: .shazam | Windy: extra webcams | Keith: alternate download API
IMGBB_KEY=
OCR_API_KEY=
GOOGLE_STT_KEY=
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
WINDY_WEBCAMS_KEY=
KEITH_BASE=https://apiskeith2-production-3020.up.railway.app

# ── OPTIONAL: Dashboard ──────────────────────
# Shared secret the dashboard app sends in the x-api-key header.
# Set this to a long random string if you expose the dashboard.
DASHBOARD_API_KEY=
# Port override. Panels (nodeX/Pterodactyl/Heroku/Render) inject their
# own allocation as PORT automatically — leave this unset on panels.
# DASHBOARD_PORT=
# Restore bot settings from a base64 backup (heavenly restores).
# BOT_SETTINGS_DATA=

# ── OPTIONAL: Advanced ───────────────────────
# Comma-separated extra dev numbers ( digits only, no + ).
# Empty = nobody. Owner always has full power regardless.
DEV_NUMBERS=
# Delay boot by N ms (stagger restarts after crashes).
# CELESTIA_RESTART_DELAY_MS=

# ── PANEL NETWORKING (nodeX/Pterodactyl) ─────
# Your panel assigns the port automatically and injects it as PORT —
# she listens on it with zero config. Give the container ONE allocation.
# Nothing to fill in here. Health check: GET /health
