# CELESTIA — copy to .env and fill in (never commit .env)
# One bot per WhatsApp number: YOU become the owner of your instance.

# --- Required ---
# WhatsApp session string (CELESTIA:~... format). Get it from the pairing
# station (pairing-site.js, :3001) or the bot's first-link DM backup.
# Treat like a password — anyone holding it controls that WhatsApp link.
SESSION_ID=
# Owner WhatsApp number: digits only with country code, no + (e.g. 2547XXXXXXXX)
OWNER_NUMBER=
QR_ACCESS_TOKEN=

# --- Identity / behavior (all optional) ---
BOT_NAME=CELESTIA
BOT_PREFIX=.
TIMEZONE=Africa/Nairobi

# --- Business assistant (optional, disabled by default) ---
# Turns this deployment into a salon/barbershop booking assistant. Bookings
# persist under /app/data and the owner receives confirmation notifications.
BUSINESS_ASSISTANT_ENABLED=false
BUSINESS_NAME=Celestia Cuts
BUSINESS_CURRENCY=KES
BUSINESS_HOURS=Monday-Saturday, 8:00 AM-7:00 PM
BUSINESS_LOCATION=Nairobi, Kenya
BUSINESS_CONTACT_TEXT=A team member has been notified and will reply here.
# ISO weekdays: Monday=1 through Sunday=7.
BUSINESS_OPEN_DAYS=1,2,3,4,5,6
BUSINESS_BOOKING_SLOTS=09:00,10:00,11:00,13:00,14:00,15:00,16:00
# Must be valid JSON on one line.
BUSINESS_SERVICES_JSON=[{"name":"Haircut","price":500,"durationMinutes":45},{"name":"Beard trim","price":300,"durationMinutes":30},{"name":"Haircut + beard","price":700,"durationMinutes":60}]

# --- AI brains, first success wins (all optional) ---
# Apix hub key (unlimited premium if you have it) — primary AI brain AND
# song/video downloads (same-host proxied bytes, survives datacenter blocks)
APIX_KEY=
# OpenRouter key — free-model chain (OR_MODELS in autochat/backend.js)
OPENROUTER_API_KEY=
# OpenCode Zen key — free-model chain (ZEN_MODELS in autochat/backend.js)
OPENZEN_API_KEY=
# Groq key — fast free-model chain (GROQ_MODELS in autochat/backend.js)
GROQ_API_KEY=
# NVIDIA NIM key — NIM chain (NVIDIA_MODELS in autochat/backend.js)
NVIDIA_API_KEY=
# Direct provider keys (fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
# OpenAI chat model for the autochat fallback (e.g. gpt-4o-mini, gpt-4o).
# Note: this is NOT your ChatGPT Plus subscription — it needs an API key
# with billing at platform.openai.com (pay-per-use, separate from Plus).
OPENAI_MODEL=gpt-4o-mini
# Official Codex SDK provider using ChatGPT subscription authentication.
# Credentials live in $CODEX_HOME/auth.json; never put that file in Git.
CODEX_HOME=
CODEX_MODEL=gpt-5.6-luna

# --- Command integrations (optional; commands report unavailable when omitted) ---
# ACRCloud song recognition (.shazam)
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
# Google Speech-to-Text (.totext / .transcribe)
GOOGLE_STT_KEY=
# lolhuman animated text stickers (.attp)
LOLHUMAN_API_KEY=
# Instagram posts/reels/stories/profile pictures: Cookie header from your own
# logged-in Instagram session (sessionid=...; csrftoken=...). Set as a runtime
# secret; never commit it. Used only for requests to www.instagram.com.
INSTAGRAM_COOKIE=
# Optional legacy file override. Panel updates use persistent data/instagram-cookie.txt
# and take priority without restarting the bot.
INSTAGRAM_COOKIE_FILE=

# --- Pairing without a local machine ---
# PAIR_MODE=true → app prints a pairing code in the logs instead of booting
# the bot. Link it in WhatsApp, grab SESSION_ID, flip back to false, redeploy.
PAIR_MODE=false

# --- YouTube cookies (fixes "Sign in to confirm you're not a bot") ---
# Export youtube.com cookies (Netscape format) from your browser, or privately
# reply to the document with .ytcookies upload. Stored under persistent data.
# Never commit cookies. Existing cookies/youtube.txt files are still detected
# when YOUTUBE_COOKIES_FILE is unset.
YOUTUBE_COOKIES_FILE=./data/youtube-cookies.txt
# Optional private HTTPS source serving a fresh signed-in Netscape cookies.txt.
# The bot checks on download, refreshes expired/rejected jars and retries once
# only if a different valid jar is supplied. It cannot generate new logins.
YOUTUBE_COOKIES_URL=
YOUTUBE_COOKIES_REFRESH_SECONDS=1800
# Private multi-bot cloud deployments can mount one owner-scoped shared jar.
# Readers get read-only mounts; set READ_ONLY=false only on the managing bot.
YOUTUBE_COOKIES_SHARED=false
YOUTUBE_COOKIES_READ_ONLY=false
# Optional Node >=22 binary for yt-dlp challenges if the bot itself uses Node 20.
# Private shared fleets also detect a node22 binary beside the shared cookie file.
YTDLP_NODE_PATH=
# Commercial deployments: use a dedicated residential/static ISP proxy
# instead of account cookies. Include credentials in the URL when required.
# Example: http://username:password@proxy.example.com:8000
YOUTUBE_PROXY=
# Optional single source address assigned and authorized on this host.
YOUTUBE_SOURCE_ADDRESS=

# --- Live web search (SearXNG metasearch, optional) ---
# Your own instance goes first (self-host for commercial use, JSON enabled).
# Without it, the bot rotates public instances until one answers.
SEARXNG_URL=

# --- Misc (all optional) ---
# DASHBOARD_PORT is ignored where the platform assigns PORT (Heroku/Render)
DASHBOARD_PORT=3000
# Shared secret for the dashboard x-api-key header
DASHBOARD_API_KEY=
# Log verbosity: silent, error, warn, info, debug
LOG_LEVEL=info
# Base64 bot-settings backup, restored on boot if data/ is empty
BOT_SETTINGS_DATA=
