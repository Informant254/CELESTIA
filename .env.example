# CELESTIA — copy to .env and fill in (never commit .env)
# One bot per WhatsApp number: YOU become the owner of your instance.

# --- Required ---
# WhatsApp session string (CELESTIA:~... format). Get it from the pairing
# station (pairing-site.js, :3001) or the bot's first-link DM backup.
# Treat like a password — anyone holding it controls that WhatsApp link.
SESSION_ID=
# Owner WhatsApp number: digits only with country code, no + (e.g. 2547XXXXXXXX)
OWNER_NUMBER=
QR_ACCESS_TOKEN=

# --- Identity / behavior (all optional) ---
BOT_NAME=CELESTIA
BOT_PREFIX=.
TIMEZONE=Africa/Nairobi

# --- AI brains, first success wins (all optional) ---
# Apix hub key (unlimited premium if you have it) — primary AI brain AND
# song/video downloads (same-host proxied bytes, survives datacenter blocks)
APIX_KEY=
# OpenRouter key — free-model chain (OR_MODELS in autochat/backend.js)
OPENROUTER_API_KEY=
# OpenCode Zen key — free-model chain (ZEN_MODELS in autochat/backend.js)
OPENZEN_API_KEY=
# Direct provider keys (fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
# OpenAI chat model for the autochat fallback (e.g. gpt-4o-mini, gpt-4o).
# Note: this is NOT your ChatGPT Plus subscription — it needs an API key
# with billing at platform.openai.com (pay-per-use, separate from Plus).
OPENAI_MODEL=gpt-4o-mini
# Official Codex SDK provider using ChatGPT subscription authentication.
# Credentials live in $CODEX_HOME/auth.json; never put that file in Git.
CODEX_HOME=
CODEX_MODEL=gpt-5.6-luna

# --- Command integrations (optional; commands report unavailable when omitted) ---
# ACRCloud song recognition (.shazam)
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
# Google Speech-to-Text (.totext / .transcribe)
GOOGLE_STT_KEY=
# lolhuman animated text stickers (.attp)
LOLHUMAN_API_KEY=

# --- Pairing without a local machine ---
# PAIR_MODE=true → app prints a pairing code in the logs instead of booting
# the bot. Link it in WhatsApp, grab SESSION_ID, flip back to false, redeploy.
PAIR_MODE=false

# --- YouTube cookies (fixes "Sign in to confirm you're not a bot") ---
# Export youtube.com cookies (netscape format) from your browser into
# cookies/youtube.txt (or set this path). Never commit that file.
YOUTUBE_COOKIES_FILE=./cookies/youtube.txt
# Commercial deployments: use a dedicated residential/static ISP proxy
# instead of account cookies. Include credentials in the URL when required.
# Example: http://username:password@proxy.example.com:8000
YOUTUBE_PROXY=
# Optional single source address assigned and authorized on this host.
YOUTUBE_SOURCE_ADDRESS=

# --- Live web search (SearXNG metasearch, optional) ---
# Your own instance goes first (self-host for commercial use, JSON enabled).
# Without it, the bot rotates public instances until one answers.
SEARXNG_URL=

# --- Misc (all optional) ---
# DASHBOARD_PORT is ignored where the platform assigns PORT (Heroku/Render)
DASHBOARD_PORT=3000
# Shared secret for the dashboard x-api-key header
DASHBOARD_API_KEY=
# Log verbosity: silent, error, warn, info, debug
LOG_LEVEL=info
# Base64 bot-settings backup, restored on boot if data/ is empty
BOT_SETTINGS_DATA=
